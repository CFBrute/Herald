<Window x:Class="Herald.ClaudeConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Claude Code to Herald?" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="Bold"/>
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Connecting adds a hook to Claude Code's settings (a backup of the old file is kept), so each block of Claude's reply is read aloud as it appears. You can disconnect again under Settings > Claude Code."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Connect" Width="90" IsDefault="True" Click="Connect_Click"/>
            <Button Content="Not now" Width="90" Margin="8,0,0,0" IsCancel="True" Click="NotNow_Click"/>
            <Button Content="Don't ask again" Width="110" Margin="8,0,0,0" Click="DontAsk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
