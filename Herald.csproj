<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has no tray icon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The exe's icon; windows without an Icon of their own use it too. -->
    <ApplicationIcon>Assets\Herald.ico</ApplicationIcon>
    <!-- The test project lives in a subfolder; keep its files out of Herald itself. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Herald.Tests\**</DefaultItemExcludes>
    <!-- A single-file publish carries ONNX Runtime's native DLL (Kokoro) inside the exe too;
         it's unpacked to a temp folder when Herald starts. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Bumped by hand for a new version; the third number is the git commit count,
         filled in by StampBuildVersion below. -->
    <VersionPrefix>1.0</VersionPrefix>
    <!-- The version text is built below, with the short commit instead of the full one. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ONNX Runtime's package also ships .lib files for C++ projects; Herald doesn't use them,
       and without this they'd sit next to the single-file exe. -->
  <Target Name="LeaveOutImportLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

  <!-- Stamps the version (1.0.<commit count>), the commit it was built from (with "*" when
       there were uncommitted changes) and the build time into Herald.exe, shown in the
       main window. Without git the version is 1.0.0 and there is no commit. -->
  <Target Name="StampBuildVersion" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="HeraldCommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="HeraldGitExitCode" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" Condition="'$(HeraldGitExitCode)' == '0'" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="HeraldCommit" />
    </Exec>
    <Exec Command="git status --porcelain" ConsoleToMSBuild="true" IgnoreExitCode="true" Condition="'$(HeraldGitExitCode)' == '0'" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="HeraldGitChanges" />
    </Exec>
    <PropertyGroup>
      <HeraldCommitCount Condition="'$(HeraldGitExitCode)' != '0'">0</HeraldCommitCount>
      <HeraldCommit Condition="'$(HeraldGitExitCode)' != '0'"></HeraldCommit>
      <HeraldCommit Condition="'$(HeraldCommit)' != '' and '$(HeraldGitChanges)' != ''">$(HeraldCommit)*</HeraldCommit>
      <Version>$(VersionPrefix).$(HeraldCommitCount)</Version>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
      <InformationalVersion Condition="'$(HeraldCommit)' != ''">$(Version)+$(HeraldCommit)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildTime</_Parameter1>
        <_Parameter2>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Resource Include="Assets\Herald.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WPF's types unambiguous (MessageBox, Clipboard, Button, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The phonemes Kokoro knows, from kokoro-onnx's config.json. -->
    <EmbeddedResource Include="Services\Engines\Kokoro\kokoro-vocab.json" LogicalName="kokoro-vocab.json" />
    <!-- How other programs talk to Herald, shown from Settings. -->
    <EmbeddedResource Include="docs\talking-to-herald.md" LogicalName="talking-to-herald.md" />
  </ItemGroup>

</Project>
