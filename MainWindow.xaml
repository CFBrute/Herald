<Window x:Class="Herald.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Herald" Height="600" Width="780"
        Foreground="{DynamicResource PrimaryText}">
    <Window.Resources>
        <!-- Alternating shade per message: all parts of one message share a background. -->
        <Style x:Key="BandedItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <!-- No vertical padding, so the stripe runs unbroken through a message's parts. -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource ItemBackground}"/>
            <!-- A plain template: the theme's own adds spacing around each item, which
                 would break the stripe between the parts of a message. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverItemBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedItemBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Band}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource ItemAltBackground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Coloured stripe on the left of each message, alternating like the background. -->
        <Style x:Key="BandStripe" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Band}" Value="1">
                    <Setter Property="Background" Value="#F59E0B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LanguageBadge" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Language}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="SeaGreen"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="ToolTip" Value="Language detected by a language profile"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Language}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CopyBadge" TargetType="TextBlock">
            <Setter Property="Text" Value="copy"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="MediumPurple"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="ToolTip" Value="Played again from History"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCopy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Item text is plain until "Select text" is chosen, so clicks and
             double-clicks go to the list instead of starting a text selection. -->
        <Style x:Key="ItemText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Text}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectingText}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectableItemText" TargetType="TextBox">
            <Setter Property="Text" Value="{Binding Text, Mode=OneWay}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource SelectionBoxBackground}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectingText}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Controls row: playback controls on the left, Settings far right -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ToggleButton x:Name="EnabledToggle" Content="Speech: ON" Width="120" Height="32"
                              Click="EnabledToggle_Click" IsChecked="True"/>
                <Button x:Name="SkipButton" Content="Skip part" Width="80" Height="32" Margin="10,0,0,0"
                        ToolTip="Skip the part that's playing; the next part of the message follows"
                        Click="SkipButton_Click"/>
                <Button x:Name="SkipMessageButton" Content="Skip message" Width="120" Height="32" Margin="6,0,0,0"
                        ToolTip="Skip the rest of the current message"
                        Click="SkipMessageButton_Click"/>
            </StackPanel>
            <Button x:Name="SettingsButton" Content="Settings" Width="80" Height="32" HorizontalAlignment="Right"
                    Click="SettingsButton_Click"/>
        </Grid>

        <!-- Queue + History -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock DockPanel.Dock="Top" Text="Queue" FontWeight="Bold" Margin="0,0,0,6"/>
                <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="ManualSpeakBox" VerticalContentAlignment="Center"
                             KeyDown="ManualSpeakBox_KeyDown" ToolTip="Type something and press Enter to have Herald speak it"/>
                    <Button Grid.Column="1" Content="Speak" Width="60" Margin="6,0,0,0" Click="SpeakButton_Click"/>
                </Grid>
                <ListBox x:Name="QueueList" ItemsSource="{Binding Queue}"
                         ItemContainerStyle="{StaticResource BandedItem}" Background="{DynamicResource ListBackground}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyDown="ItemList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource BandStripe}"/>
                            <StackPanel Background="Transparent" Margin="0,3,4,3" ToolTip="{Binding SynthesisInfo}">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Select text" Click="SelectText_Click"/>
                                        <MenuItem Header="Copy text" Click="CopyText_Click"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Sender}" FontWeight="Bold" FontSize="10"
                                               Foreground="White" Background="SteelBlue" Padding="4,0,4,0"/>
                                    <TextBlock Style="{StaticResource CopyBadge}"/>
                                    <TextBlock Style="{StaticResource LanguageBadge}"/>
                                    <TextBlock Text="{Binding PartLabel}" FontSize="10" Foreground="{DynamicResource SubtleText}" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="10"
                                               Foreground="{DynamicResource StatusText}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource ItemText}"/>
                                    <TextBox Style="{StaticResource SelectableItemText}"
                                             LostKeyboardFocus="SelectableText_LostKeyboardFocus"/>
                                </Grid>
                            </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="History" FontWeight="Bold" Margin="0,0,0,6"
                           ToolTip="Double-click an item to play it again; right-click for more options"/>
                <!-- Bottom row, mirroring the Speak row under the Queue. -->
                <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button Content="Clear history" HorizontalAlignment="Right" Padding="12,0" Height="32"
                            ToolTip="Removes every item from History, including its saved audio"
                            Click="ClearHistoryButton_Click"/>
                </Grid>
                <ListBox x:Name="HistoryList" ItemsSource="{Binding History}"
                         ItemContainerStyle="{StaticResource BandedItem}" Background="{DynamicResource ListBackground}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="HistoryList_MouseDoubleClick"
                         KeyDown="ItemList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource BandStripe}"/>
                            <StackPanel Background="Transparent" Margin="0,3,4,3" ToolTip="{Binding SynthesisInfo}">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Play again" FontWeight="Bold" Click="PlayAgain_Click"/>
                                        <MenuItem Header="Select text" Click="SelectText_Click"/>
                                        <MenuItem Header="Copy text" Click="CopyText_Click"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Sender}" FontWeight="Bold" FontSize="10"
                                               Foreground="White" Background="SteelBlue" Padding="4,0,4,0"/>
                                    <TextBlock Style="{StaticResource CopyBadge}"/>
                                    <TextBlock Style="{StaticResource LanguageBadge}"/>
                                    <TextBlock Text="{Binding PartLabel}" FontSize="10" Foreground="{DynamicResource SubtleText}" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding EnqueuedAt}" FontSize="10" Foreground="{DynamicResource SubtleText}"
                                               Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SubtleText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource ItemText}"/>
                                    <TextBox Style="{StaticResource SelectableItemText}"
                                             LostKeyboardFocus="SelectableText_LostKeyboardFocus"/>
                                </Grid>
                            </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Text="Listening on 127.0.0.1:8766"
                   Foreground="{DynamicResource SubtleText}" Margin="0,10,0,0"/>
    </Grid>
</Window>
